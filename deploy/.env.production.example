# MeetMind 生产环境变量模板
#
# 使用方法：
#   cp deploy/.env.production.example deploy/.env.production
#   然后填入真实值；该文件权限建议 600，且不要提交到 Git
#
# 注意：本文件中的所有值都必须改掉，尤其是密码与密钥。

# ---------- 对外访问端口 ----------
# nginx 映射到宿主机的端口。腾讯云需在防火墙放行同一端口。
HTTP_PORT=80

# ---------- PostgreSQL ----------
POSTGRES_USER=meetmind
# 生产务必改成强密码（建议 24 位以上随机串）
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=meetmind

# ---------- 应用密钥 ----------
# JWT 签名密钥。泄露等同可任意伪造登录态。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_put_a_random_48_byte_string_here

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=CHANGE_ME_your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
