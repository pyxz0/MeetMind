generator client {
  // 生成与本项目 Prisma Client 依赖兼容的客户端代码。
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL 连接串由 prisma7.config.ts 的 DATABASE_URL 提供。
  provider = "postgresql"
}

/// 会议处理阶段；当前保存成功的纪要使用 READY。
enum MeetingStatus {
  DRAFT
  PROCESSING
  READY
  FAILED
}

enum MeetingCompletionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// 行动项的跟踪状态。
///
/// SUBMITTED 表示「已提交、等待验收」，**不属于完成**：
/// 会议完成判定只认 COMPLETED / CANCELLED，因此待验收期间会议保持进行中。
enum TodoStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  COMPLETED
  CANCELLED
}

/// 单次交付的验收结果。
///
/// PENDING 同时最多一条（部分唯一索引保证），避免同一待办被重复提交。
enum SubmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

/// 用户角色，三级分级。
/// SUPER_ADMIN 管理管理员与系统；ADMIN 管理普通用户与全部会议；USER 只能管理自己的数据。
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

/// 私信消息类型。
enum MessageKind {
  TEXT
  IMAGE
  FILE
}

/// 审计日志。
///
/// 记录"谁在什么时候对什么资源做了什么"。
/// actor 可空：账号被删除后历史记录仍需保留（外键 SET NULL）。
model AuditLog {
  id             Int      @id @default(autoincrement())
  /// 操作者；账号被删后置空
  actorId        Int?     @map("actor_id")
  /// 代登场景下的真实操作者
  impersonatedBy Int?     @map("impersonated_by")
  /// 动作标识，如 meeting.delete / user.update_role
  action         String   @db.VarChar(64)
  /// 资源类型：meeting / user / share
  resourceType   String   @map("resource_type") @db.VarChar(32)
  /// 资源 id
  resourceId     String?  @map("resource_id") @db.VarChar(64)
  /// 附加信息（修改前后的值等）
  metadata       Json?
  /// 客户端 IP
  ip             String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

/// AI 生成任务状态
/// AI 生成任务状态
enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// 会议共享权限：只读 / 可编辑。
enum SharePermission {
  READ
  EDIT
}

/// 系统用户。密码只保存 bcrypt 哈希，永不落库明文。
///
/// 超级管理员唯一性（重要）：
/// 全局只允许一个 SUPER_ADMIN。应用层在 UsersService 中限制
/// 创建/提升/降级/停用/删除，数据库层由迁移
/// 20261018010107_single_super_admin 建立的部分唯一索引
/// `users_single_super_admin_key` 兜底。
/// 该索引带 WHERE 条件，Prisma schema 无法表达，因此不在这里声明 ——
/// 但请勿手动删除它，否则唯一性只剩应用层保证。
model User {
  id           Int       @id @default(autoincrement())
  /// 手机号，唯一登录标识。
  /// 存 11 位中国大陆手机号（不带 +86 前缀），入库前统一去空格与分隔符。
  phone        String    @unique @db.VarChar(20)
  /// 绑定邮箱：用于自助找回密码。可为空（老账号与不填的用户），一旦绑定即唯一。
  /// 不做登录标识 —— 登录仍然只认手机号。
  email        String?   @unique @db.VarChar(160)
  /// bcrypt 哈希；接口返回时永远剔除该字段。
  passwordHash String    @map("password_hash") @db.VarChar(120)
  /// 展示名称。
  name         String    @db.VarChar(80)
  /// 头像：前端压到 256px 的 JPEG data URL；为空时界面用姓名首字。
  /// 存 data URL 而不是文件路径，是为了避免再引入一套静态资源与鉴权规则：
  /// 头像很小（约 15–30KB），随用户接口一起返回即可。
  avatar       String?   @db.Text
  role         Role      @default(USER)
  /// 停用后无法登录，用于回收权限而不删除数据。
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// 收件箱最后一次已读时间；早于该时间的通知算已读
  inboxSeenAt  DateTime? @map("inbox_seen_at") @db.Timestamptz(3)

  /// 是否接收邮件提醒。
  /// 默认开启：绑邮箱这个动作本身已经表达了「愿意用它联系我」；
  /// 但仍然给个人中心一个开关，随时能关 —— 通知最容易招人烦的就是关不掉。
  notifyEmail Boolean @default(true) @map("notify_email")

  /// 密码重置令牌的 SHA-256（只存哈希，不存原文）；为空表示没有待用的重置链接
  passwordResetTokenHash String?   @map("password_reset_token_hash") @db.VarChar(64)
  /// 重置令牌过期时间；与令牌同时写入、同时清除
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at") @db.Timestamptz(3)
  /// 令牌版本：改密或重置密码后自增，令已签发的 JWT 立即失效
  tokenVersion           Int       @default(0) @map("token_version")

  /// 自己创建的会议。
  meetings           Meeting[]           @relation("MeetingOwner")
  /// 由该用户担任负责人的会议。
  ledMeetings        MeetingLeader[]     @relation("MeetingLeaderUser")
  /// 该用户作为成员参与的会议。
  meetingMemberships MeetingMember[]     @relation("MeetingMemberUser")
  /// 收件箱已读记录。
  inboxReads         InboxRead[]
  /// 收到的会议变更消息。
  notices            MeetingNotice[]     @relation("NoticeRecipient")
  /// 该用户发起的 AI 生成任务。
  generations        MeetingGeneration[] @relation("GenerationOwner")
  /// 该用户上传的转写任务。
  asrJobs            AsrJob[]            @relation("AsrJobUser")
  /// 该用户产生的审计日志。
  auditLogs          AuditLog[]          @relation("AuditActor")
  /// 别人共享给该用户的会议。
  sharedWithMe       MeetingShare[]      @relation("ShareRecipient")
  /// 该用户做过的共享操作（用于追溯是谁授的权）。
  sharesGiven        MeetingShare[]      @relation("ShareGrantor")

  /// 指派给该用户的待办。
  todosAssigned   Todo[]               @relation("TodoAssignee")
  /// 由该用户验收的待办。
  todosToReview   Todo[]               @relation("TodoReviewer")
  /// 该用户提交过的交付。
  todoSubmissions TodoSubmission[]     @relation("SubmissionSubmitter")
  /// 该用户验收过的交付。
  todoReviews     TodoSubmission[]     @relation("SubmissionReviewer")
  /// 该用户产生的待办流转记录。
  todoEvents      TodoEvent[]          @relation("TodoEventActor")
  /// 该用户勾选过的验收要点。
  todoCheckItems  TodoCheckItem[]      @relation("TodoCheckDoneBy")
  /// 该用户参与的私信会话。
  conversations   ConversationMember[] @relation("ConversationMemberUser")
  /// 该用户作为会话成员 A / B 的会话（一对一聊天）。
  conversationsA  Conversation[]       @relation("ConversationUserA")
  conversationsB  Conversation[]       @relation("ConversationUserB")
  /// 该用户参与过的会议状态变更操作。
  meetingEvents   MeetingEvent[]       @relation("MeetingEventActor")

  /// 该用户在会议追问里提过的问题（含对应的回答）
  meetingChats MeetingChatMessage[] @relation("MeetingChatAuthor")
  /// 该用户发出的私信。
  messagesSent Message[]            @relation("MessageSender")

  @@index([role])
  @@map("users")
}

/// AI 生成任务。
///
/// 之前生成是同步长请求：AI 慢就超时、用户重复点击会并发生成、
/// 失败后也没有可追踪的状态。改为「建任务 → 后台执行 → 前端轮询」。
model MeetingGeneration {
  id          Int              @id @default(autoincrement())
  /// 发起人，用于权限校验与重复提交判定
  userId      Int              @map("user_id")
  /// 会议 id：任务开始时会议尚未创建，因此可空
  meetingId   Int?             @map("meeting_id")
  /// 内容指纹：同用户同内容的进行中任务会被复用，避免重复生成
  contentHash String           @map("content_hash") @db.VarChar(64)
  status      GenerationStatus @default(PENDING)
  /// 失败原因，成功时为空
  error       String?          @db.Text
  startedAt   DateTime?        @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime?        @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation("GenerationOwner", fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([meetingId])
  @@map("meeting_generations")
}

/// 会议变更消息。
///
/// 负责人/成员/共享这类「关系」可以派生通知，但「会议时间改了」是一次性事件，
/// 无法从当前状态反推，所以需要落库。
/// 收件箱会把这类消息与派生通知合并展示。
model MeetingNotice {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  meetingId Int       @map("meeting_id")
  /// 消息正文，已按收件人视角写好（如「你已被移出会议」）
  content   String    @db.Text
  /// 消息类型：update 预约信息变更 / reminder 会议即将开始
  kind      String    @default("update") @db.VarChar(20)
  /// 邮件投递时间。为空表示还没通过邮件发出，下一轮扫描会捡走。
  /// 先用它「抢占」再发信：抢到才发，发失败回滚成 null 等下次重试。
  emailedAt DateTime? @map("emailed_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User    @relation("NoticeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  /// 出站扫描：只找还没发出去的
  @@index([emailedAt, createdAt])
  @@map("meeting_notices")
}

/// 收件箱单条已读记录。
///
/// 只用时间戳（users.inbox_seen_at）无法表达「只读了其中一条」，
/// 因此按 item_key 记录已读，支持点击某条通知后它立刻变为已读。
/// item_key 由通知类型 + 会议 id 组成，稳定可复现。
model InboxRead {
  id      Int      @id @default(autoincrement())
  userId  Int      @map("user_id")
  itemKey String   @map("item_key") @db.VarChar(120)
  readAt  DateTime @default(now()) @map("read_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@index([userId])
  @@map("inbox_reads")
}

/// 会议负责人：一场会议可以有多位负责人。
///
/// 与成员分开建表：负责人拥有编辑、管成员、控录音等权限，
/// 成员只有读与勾选待办；同一个人可以同时是负责人与成员。
model MeetingLeader {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("MeetingLeaderUser", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一场会议对同一个用户只保留一条负责人记录
  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_leaders")
}

/// 会议成员：记录参会人。
///
/// 负责人也可以同时是成员（不写进本表也能看会议，写进来只是显式列出）；
/// 会议创建者同理，不强制入表。
model MeetingMember {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  userId    Int      @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation("MeetingMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  /// 同一场会议对同一个用户只保留一条成员记录
  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_members")
}

/// 会议共享关系：把某场会议授权给某个用户。
/// 会议的所有者不写在这张表里，避免与 ownerId 双写产生不一致。
model MeetingShare {
  id          Int             @id @default(autoincrement())
  meetingId   Int             @map("meeting_id")
  userId      Int             @map("user_id")
  permission  SharePermission @default(READ)
  /// 是谁授予的，便于审计。
  grantedById Int             @map("granted_by_id")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user      User    @relation("ShareRecipient", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("ShareGrantor", fields: [grantedById], references: [id], onDelete: Cascade)

  /// 同一场会议对同一个用户只保留一条授权（重复分享等于更新权限）。
  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_shares")
}

/// 会议主记录：保存原始文本、生成纪要和创建时间。
model Meeting {
  /// 数据库自增主键，也是前端详情和删除接口使用的 ID。
  id               Int           @id @default(autoincrement())
  /// 会议显示名称；未提供标题时使用默认名称。
  title            String        @default("未命名会议") @db.VarChar(200)
  /// 用户输入的完整会议原文。
  content          String        @db.Text
  /// AI 生成的摘要，可为空以兼容尚未生成摘要的草稿。
  summary          String?       @db.Text
  /// 会议录音的站内相对路径，例如 uploads/xxx.webm。
  /// 为空表示这场会议没有留存录音（例如纯文字输入）。
  audioUrl         String?       @map("audio_url") @db.VarChar(255)
  /// 录音时长（秒），与转写计时一致；暂停期间不计入。
  audioDurationSec Int?          @map("audio_duration_sec")
  /// 置顶时间；为空表示未置顶。
  /// 用时间戳而非布尔值，多条置顶之间才能按“最近置顶优先”稳定排序。
  pinnedAt         DateTime?     @map("pinned_at") @db.Timestamptz(3)
  /// 主记录状态，用于区分草稿、处理中、完成和失败。
  status           MeetingStatus @default(READY)
  /// 带时区的创建时间，映射为数据库的 snake_case 字段名。
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  /// 该会议提取出的关键决策，删除会议时一并删除。
  decisions        Decision[]
  /// 该会议提取出的行动项，删除会议时一并删除。
  todos            Todo[]

  completionStatus MeetingCompletionStatus @default(NOT_STARTED)

  /// 会议归属者。所有数据隔离都以该字段为准：
  /// 用户只能看到自己拥有的、或被共享给自己的会议。
  ownerId Int  @map("owner_id")
  owner   User @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  /// 会议负责人（可多位）。每场会议至少要有一位。
  leaders MeetingLeader[]

  /// 录音是否对「非负责人」开放。
  /// 关闭后只有负责人、会议创建者与超级管理员能听，成员与共享者都听不到。
  audioOpen Boolean @default(true) @map("audio_open")

  /// 正式会议的开会时间。为空表示临时会议（即时开始）。
  /// 距离开会时间不足 20 分钟时，参会人员会在收件箱收到提醒。
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(3)

  /// 来源平台。为空表示 MeetMind 自建；'tencent' 表示来自腾讯会议同步。
  /// 用字符串而不是 enum，是为了以后接飞书/zoom 时不用再改表结构。
  sourcePlatform String? @map("source_platform") @db.VarChar(20)

  /// 平台侧的会议 ID。
  /// 腾讯会议的 meeting_id 是长数字串，超出 int 范围，必须用 String。
  externalId String? @map("external_id") @db.VarChar(64)

  /// 入会链接。同步自平台，点一下就能进会。
  externalJoinUrl String? @map("external_join_url") @db.VarChar(512)

  /// 会议号（给人念的那串数字，腾讯会议 9-11 位）。
  externalCode String? @map("external_code") @db.VarChar(32)

  /// 会议成员（参会人）。
  members MeetingMember[]

  /// 该会议发出的变更消息。
  notices MeetingNotice[]

  /// 该会议的 AI 生成任务。
  generations MeetingGeneration[]

  /// 该会议的追问记录（人机问答），随会议删除。
  chatMessages MeetingChatMessage[]

  /// 会议状态的手动变更记录（谁在什么时候把状态改成了什么）。
  events MeetingEvent[]

  /// 该会议对其他用户的共享授权。
  shares MeetingShare[]

  /// 同一场平台会议只能对应一条记录，避免 webhook 重推时重复建会。
  /// sourcePlatform 为空的（自建会议）不受约束 —— PG 里 NULL 不参与唯一比较。
  @@unique([sourcePlatform, externalId])
  /// 常用历史列表按时间排序；状态筛选列表按状态和时间排序。
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  /// 历史列表需要把已置顶的会议排在最前，并按置顶时间倒序。
  @@index([pinnedAt(sort: Desc)])
  /// 数据隔离的核心查询：按归属者过滤列表。
  @@index([ownerId, createdAt(sort: Desc)])
  /// 收件箱提醒要按开会时间扫描。
  @@index([scheduledAt])
  @@map("meetings")
}

/// AI 从会议内容中提取的决策条目。
model Decision {
  id        Int     @id @default(autoincrement())
  /// 所属会议的外键。
  meetingId Int     @map("meeting_id")
  /// 决策的原文描述。
  content   String  @db.Text
  /// 同一会议内的展示顺序。
  sortOrder Int     @default(0) @map("sort_order")
  /// 删除所属会议时级联删除此决策。
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  /// 按会议读取并按录入顺序展示决策。
  @@index([meetingId, sortOrder])
  @@map("meeting_decisions")
}

/// AI 从会议内容中提取的待办或行动项。
model Todo {
  id                 Int        @id @default(autoincrement())
  /// 所属会议的外键。
  meetingId          Int        @map("meeting_id")
  /// 需要完成的任务描述。
  content            String     @db.Text
  /// 负责人可能未被会议原文明确指定。
  assignee           String?    @db.VarChar(120)
  /// 结构化的负责人。文本 assignee 保留做展示与历史兼容，
  /// 归属判定与「谁能提交」一律以本字段为准（文本匹配会把张三丰认成张三）。
  assigneeUserId     Int?       @map("assignee_user_id")
  /// 验收人；为空表示该待办不需要验收，保持旧的一键完成行为。
  reviewerId         Int?       @map("reviewer_id")
  /// 保留自然语言截止时间，例如“下周一”，避免丢失模型原始表达。
  deadline           String?    @db.VarChar(120)
  /// 结构化的截止时间。自然语言解析不了就留空，只保留 deadline 文本。
  deadlineAt         DateTime?  @map("deadline_at") @db.Timestamptz(3)
  /// 待办处理状态，默认处于未开始状态。
  status             TodoStatus @default(OPEN)
  /// 上一次逾期提醒的时间。
  /// 与 overdueNotifyCount 一起保证「同一条待办每天最多提醒一次」，
  /// 改期到未来或状态回退时一起清零，否则改回来就再也不提醒了。
  overdueNotifiedAt  DateTime?  @map("overdue_notified_at") @db.Timestamptz(3)
  /// 连续逾期提醒次数。达到上限后不再提醒 ——
  /// 一条放了一个月的待办每天发一封信，只会让人把整个域名拉黑。
  overdueNotifyCount Int        @default(0) @map("overdue_notify_count")
  /// 同一会议内的展示顺序。
  sortOrder          Int        @default(0) @map("sort_order")
  /// 删除所属会议时级联删除此待办。
  meeting            Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  assigneeUser User?            @relation("TodoAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  reviewer     User?            @relation("TodoReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  submissions  TodoSubmission[]
  events       TodoEvent[]
  checkItems   TodoCheckItem[]

  /// 加速会议内排序查询和按状态筛选待办。
  @@index([meetingId, sortOrder])
  @@index([status])
  @@index([assigneeUserId, status])
  @@index([reviewerId, status])
  /// 逾期扫描：按状态筛出未完成、再比截止时间
  @@index([status, deadlineAt])
  @@map("meeting_todos")
}

/// 待办的每一次交付。
///
/// 「提交」是一件事，不是待办的一个属性：需要记录谁、何时、交了什么、谁验的、为什么打回。
/// 只改 todos.status 能跑通流程，但答不了返工次数、验收时长、谁的交付老被打回。
model TodoSubmission {
  id             Int              @id @default(autoincrement())
  todoId         Int              @map("todo_id")
  submitterId    Int              @map("submitter_id")
  /// 提交时的验收人快照；验收人后续被换掉，不影响这条记录的责任归属
  reviewerId     Int?             @map("reviewer_id")
  /// 交付说明
  note           String?          @db.Text
  status         SubmissionStatus @default(PENDING)
  /// 第几次提交（打回后递增），用于统计返工次数
  attemptNo      Int              @default(1) @map("attempt_no")
  /// 打回原因；打回时必填，其余情况为空
  rejectReason   String?          @map("reject_reason") @db.Text
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz(3)
  /// 24 小时未验收催办的发送时间；为空表示还没催过。
  /// 用时间戳而不是布尔值：能看出催办发生的时刻，也方便将来做多级催办。
  reminderSentAt DateTime?        @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  todo        Todo             @relation(fields: [todoId], references: [id], onDelete: Cascade)
  submitter   User             @relation("SubmissionSubmitter", fields: [submitterId], references: [id], onDelete: Cascade)
  reviewer    User?            @relation("SubmissionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  attachments TodoAttachment[]

  @@index([todoId, createdAt(sort: Desc)])
  @@index([status])
  @@map("todo_submissions")
}

/// 交付物附件。
///
/// 文件落 uploads 卷，下载必须走鉴权接口 —— 静态目录直出会让「看不到详情」形同虚设。
model TodoAttachment {
  id           Int      @id @default(autoincrement())
  submissionId Int      @map("submission_id")
  fileName     String   @map("file_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(128)
  sizeBytes    Int      @map("size_bytes")
  /// 相对 backend 运行目录的存储路径（uploads/todos/xxx）
  storedPath   String   @map("stored_path") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  submission TodoSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("todo_attachments")
}

/// 待办流转流水：谁在什么时候把待办从什么状态改成了什么。
///
/// 不复用 audit_logs：审计是管理员视角、门槛是 audit:read；
/// 待办时间线是业务视角，任何能看这场会议的人都该看到。
model TodoEvent {
  id           Int         @id @default(autoincrement())
  todoId       Int         @map("todo_id")
  /// 操作者；账号删除后置空，历史记录保留
  actorId      Int?        @map("actor_id")
  /// created / assigned / submitted / accepted / rejected / withdrawn / status_changed / reopened
  type         String      @db.VarChar(32)
  fromStatus   TodoStatus? @map("from_status")
  toStatus     TodoStatus? @map("to_status")
  submissionId Int?        @map("submission_id")
  metadata     Json?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  todo  Todo  @relation(fields: [todoId], references: [id], onDelete: Cascade)
  actor User? @relation("TodoEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([todoId, createdAt])
  @@map("todo_events")
}

/// 验收要点：把「怎样算通过」提前写下来，验收时逐条勾选。
///
/// 只是清单，不改变待办状态机；未勾完也能验收，但接口会把未勾数量带回去，
/// 前端在确认框里提示 —— 用清单约束质量，而不是用清单卡流程。
model TodoCheckItem {
  id        Int       @id @default(autoincrement())
  todoId    Int       @map("todo_id")
  content   String    @db.VarChar(200)
  done      Boolean   @default(false)
  doneById  Int?      @map("done_by_id")
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  todo   Todo  @relation(fields: [todoId], references: [id], onDelete: Cascade)
  doneBy User? @relation("TodoCheckDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([todoId, sortOrder])
  @@map("todo_check_items")
}

/// 服务端转写任务：上传录音 / 会议文件后由 ASR 转成文字。
///
/// 与「会议录音」分开存：转写发生在会议存在之前（用户先上传、再决定要不要生成纪要），
/// 失败的任务也不该污染会议表。
model AsrJob {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  /// 原始文件名，用于展示与预填会议标题
  filename       String   @db.VarChar(255)
  /// 相对 backend 运行目录的存储路径（uploads/asr/xxx）
  storedPath     String   @map("stored_path") @db.VarChar(255)
  sizeBytes      Int      @map("size_bytes")
  /// PENDING / RUNNING / SUCCEEDED / FAILED
  status         String   @default("PENDING") @db.VarChar(20)
  /// 转写结果；纯文本文件（txt/md）上传时直接落这里
  transcript     String?  @db.Text
  /// 音频时长（秒），由服务商返回
  durationSec    Int?     @map("duration_sec")
  /// 服务商侧任务 id（腾讯云 TaskId），用于轮询
  providerTaskId String?  @map("provider_task_id") @db.VarChar(120)
  /// 实际使用的转写通道：mock / tencent
  provider       String   @db.VarChar(32)
  error          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation("AsrJobUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("asr_jobs")
}

/// 私信会话。
///
/// 一对一聊天：一个会话固定两名成员，用唯一索引 (user_a_id, user_b_id)
/// 保证同一对人之间只有一条会话，避免并发发起时产生重复会话。
/// user_a_id 存较小的一方、user_b_id 存较大的一方，保证 (a,b) 稳定可复现。
model Conversation {
  id        Int      @id @default(autoincrement())
  userAId   Int      @map("user_a_id")
  userBId   Int      @map("user_b_id")
  /// 会话创建人（第一次发消息的人），仅用于展示，不参与权限
  createdBy Int      @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userA    User                 @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User                 @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  members  ConversationMember[]
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@map("conversations")
}

/// 会话成员：读状态挂在成员维度（每个成员各自的未读数）。
model ConversationMember {
  id                Int      @id @default(autoincrement())
  conversationId    Int      @map("conversation_id")
  userId            Int      @map("user_id")
  /// 该成员最后一次已读消息 id；小于等于它的消息算已读
  lastReadMessageId Int      @default(0) @map("last_read_message_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

/// 私信消息。
model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int         @map("conversation_id")
  senderId       Int         @map("sender_id")
  kind           MessageKind @default(TEXT)
  /// 文字内容（kind=TEXT 时有值）；图片/文件消息为可选的说明文字
  content        String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]

  @@index([conversationId, id])
  @@index([senderId])
  @@map("messages")
}

/// 私信附件（图片或文件）。
///
/// 复用交付物附件的落盘策略：上传走鉴权接口，下载不做静态目录直出。
model MessageAttachment {
  id         Int      @id @default(autoincrement())
  messageId  Int      @map("message_id")
  /// 原始文件名（展示用）
  fileName   String   @map("file_name") @db.VarChar(255)
  /// 相对 backend 运行目录的存储路径（uploads/messages/xxx）
  storedPath String   @map("stored_path") @db.VarChar(255)
  /// 文件大小（字节）
  sizeBytes  Int      @map("size_bytes")
  /// 原始 MIME 类型（下载时回给浏览器）
  mimeType   String   @map("mime_type") @db.VarChar(120)
  /// 是否图片（图片消息直接在聊天里预览，文件消息只给下载）
  isImage    Boolean  @default(false) @map("is_image")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// 会议状态变更记录。
///
/// 只记录**手动**改状态（用户在状态菜单里选的），自动流转（待办全部完成
/// 导致会议变为已完成）不写这张表 —— 那类变化已经由 todo_events 说明来源，
/// 重复记录反而让人分不清是系统算的还是人点的。
model MeetingEvent {
  id         Int      @id @default(autoincrement())
  meetingId  Int      @map("meeting_id")
  /// 操作者；账号被删后置空，历史仍保留
  actorId    Int?     @map("actor_id")
  /// 事件类型，当前只有 status_changed
  type       String   @db.VarChar(32)
  fromStatus String?  @map("from_status") @db.VarChar(24)
  toStatus   String?  @map("to_status") @db.VarChar(24)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  actor   User?   @relation("MeetingEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([meetingId, createdAt(sort: Desc)])
  @@map("meeting_events")
}

/// 会议追问的一条问答记录。
///
/// 只存文本，不改动会议的任何业务字段 —— 追问是「读」操作，
/// 不能因为问了句「把这条标成完成」就把待办改了。
/// 想改数据，走待办与状态各自的接口，那里才有权限与审计。
model MeetingChatMessage {
  id        Int      @id @default(autoincrement())
  meetingId Int      @map("meeting_id")
  /// 提问人；账号删除后置空，问答内容仍保留
  userId    Int?     @map("user_id")
  /// USER（提问）或 ASSISTANT（回答）
  role      String   @db.VarChar(16)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User?   @relation("MeetingChatAuthor", fields: [userId], references: [id], onDelete: SetNull)

  /// 打开抽屉时按时间正序取最近 N 条
  @@index([meetingId, createdAt(sort: Desc)])
  @@map("meeting_chat_messages")
}

/// 会议平台回调事件的原始记录。
///
/// 先落库、后处理：腾讯要求回调 3 秒内返回 200，拉录制、转写这些动作
/// 不能卡在响应里；落库还能让失败的事件可重放、可排查。
///
/// 幂等靠 (platform, externalEventId) 唯一索引 ——
/// 腾讯在没收到 200 时会重推，没有这个约束就会重复建会、重复转写。
model PlatformEvent {
  id       Int    @id @default(autoincrement())
  /// 平台标识：tencent
  platform String @db.VarChar(20)

  /// 事件类型：meeting.created / meeting.end / recording.completed …
  eventType String @map("event_type") @db.VarChar(64)

  /// 平台侧事件唯一标识。腾讯给的是 unique_sequence，
  /// 缺失时用 payload 的哈希兜底，保证同一事件不会处理两次。
  externalEventId String @map("external_event_id") @db.VarChar(128)

  /// 解码后的回调明文，原样保留便于排查
  payload Json

  /// RECEIVED 已入库 / PROCESSED 处理完 / IGNORED 不关心 / FAILED 处理失败
  status String @default("RECEIVED") @db.VarChar(16)

  /// 失败原因，超长截断
  error String? @db.Text

  /// 能匹配上的会议 ID；匹配不上（比如直接在腾讯会议开的会）置空
  meetingId Int? @map("meeting_id")

  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([platform, externalEventId])
  /// 补跑：按状态捞未处理的历史事件
  @@index([status, receivedAt])
  @@map("platform_events")
}
