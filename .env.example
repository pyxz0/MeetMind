# MeetMind 唯一环境变量模板
#   cp .env.example .env   然后按需修改
#
# backend 与 docker compose 都读仓库根的 .env：
#   - 本地 npm run start:dev 走 DATABASE_URL（连本机 5432）
#   - docker compose 的容器用 POSTGRES_* 拼内部连接串，不读 DATABASE_URL
#
# 该文件不要提交（.gitignore 已忽略 .env）。

# ---------- 数据库 ----------
# 本机开发时的连接串（docker compose --profile db up -d 起的库）
DATABASE_URL=postgresql://postgres:你的数据库密码@localhost:5432/meetmind?schema=public

# 容器内的库账号，compose 用它拼内部 DATABASE_URL
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=meetmind
# 宿主机映射端口，只绑 127.0.0.1
POSTGRES_PORT=5432

# ---------- 应用密钥 ----------
# JWT 签名密钥，必填；缺失时服务启动直接失败
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- 部署 ----------
# 前端对外端口
HTTP_PORT=80
# 基础镜像：Docker Hub 拉不动时换成国内镜像源
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# ---------- 邮件（自助找回密码） ----------
# 不填也能启动：重置邮件只会写进后端日志（便于本地调试）
# QQ 邮箱 / 企业邮箱都用「授权码」而不是登录密码
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- 站点地址 ----------
# 邮件里的重置链接用它拼，必须是用户能访问的地址（不要写 localhost 上线）
APP_PUBLIC_URL=http://139.199.14.204

# ---------- 服务端转写（上传录音 / 会议文件） ----------
# mock：不调外部服务，返回占位文本（仅本地开发/测试用）
# tencent：腾讯云录音文件识别，需要下面的密钥
ASR_PROVIDER=mock
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ASR_REGION=ap-guangzhou
# 文件签名密钥；不填会回落到 JWT_SECRET
ASR_URL_SECRET=
