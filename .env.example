# MeetMind 唯一环境变量模板
#   cp .env.example .env   然后按需修改
#
# backend 与 docker compose 都读仓库根的 .env：
#   - 本地 npm run start:dev 走 DATABASE_URL（连本机 5432）
#   - docker compose 的容器用 POSTGRES_* 拼内部连接串，不读 DATABASE_URL
#
# 该文件不要提交（.gitignore 已忽略 .env）。

# ---------- 数据库 ----------
# 本机开发时的连接串（docker compose --profile db up -d 起的库）
DATABASE_URL=postgresql://postgres:你的数据库密码@localhost:5432/meetmind?schema=public

# 容器内的库账号，compose 用它拼内部 DATABASE_URL
POSTGRES_USER=meetmind
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=meetmind
# 宿主机映射端口，只绑 127.0.0.1
POSTGRES_PORT=5432

# ---------- 应用密钥 ----------
# JWT 签名密钥，必填；缺失时服务启动直接失败
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---------- 大模型 ----------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- 部署 ----------
# 前端对外端口
HTTP_PORT=80
# 基础镜像：Docker Hub 拉不动时换成国内镜像源
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine